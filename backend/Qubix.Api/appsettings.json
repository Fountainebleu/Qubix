{
  "Database": {
    "MigrateOnStartup": false
  },
  "Identity": {
    "SeedRolesOnStartup": true
  },
  "Security": {
    "RequireHttps": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Qubix": "Information"
    }
  },
  "AllowedHosts": "*"
}
